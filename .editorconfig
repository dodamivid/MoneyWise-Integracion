# EditorConfig ayuda a mantener estilos consistentes entre distintos editores
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true
end_of_line = lf

# Mantener CRLF solo en scripts Windows
[*.{bat,cmd}]
end_of_line = crlf

# Asegurar LF en archivos donde CRLF puede causar problemas semánticos
[*.{sh,bash,yml,yaml,sql}]
end_of_line = lf

# Markdown: permitir espacios finales (listas, etc.)
[*.md]
trim_trailing_whitespace = false

# JSON: mismo estilo general
[*.json]
indent_size = 2
