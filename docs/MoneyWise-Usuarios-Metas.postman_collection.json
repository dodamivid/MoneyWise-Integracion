                "value": "metas:escribir",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activa\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/metas/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "metas", "1"]
            },
            "description": "Marca una meta como inactiva sin eliminarla."
          },
          "response": []
        },
        {
          "name": "Eliminar Meta",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-api-key",
                "value": "test-x-api-key",
                "type": "text"
