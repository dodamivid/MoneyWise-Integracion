              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Vacaciones Europa 2024\",\n  \"fechaFin\": \"2024-11-30\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/metas/1",
              "host": ["{{base_url}}"],
