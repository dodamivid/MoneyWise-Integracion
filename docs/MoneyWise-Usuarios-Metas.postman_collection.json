              {
                "key": "x-mw-user",
                "value": "1",
                "type": "text"
              },
              {
                "key": "x-mw-scopes",
                "value": "metas:escribir",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/metas/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "metas", "1"]
            },
            "description": "Elimina permanentemente una meta.\n\n**Importante:** Solo puedes eliminar metas que te pertenecen."
          },
          "response": []
