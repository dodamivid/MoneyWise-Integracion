DB_USER=root
DB_PASSWORD=
DB_NAME=moneywise
DB_CONNECTION_LIMIT=10

# JWT (Autenticación)
JWT_SECRET=moneywise-secret-key-CHANGE-THIS-IN-PRODUCTION
BCRYPT_ROUNDS=12

# Aplicación (para links de restablecimiento)
APP_URL=http://localhost:3000

# Swagger
OPENAPI_PATH=